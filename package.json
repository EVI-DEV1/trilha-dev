{
  "name": "trilha-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Planner de estudos para devs: trilhas, progresso, foco (Pomodoro) e integração com a API do GitHub.",
  "author": "Eliane Vitoriano Luiz (EVI-DEV1)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --poll 1500",
    "api": "json-server --watch db.json --port 3000",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run api\" \"npm start\"",
    "prebuild": "node scripts/env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "typescript": "~5.7.2"
  }
}
